{
  "name": "rural-governance-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build --mode web && vite build --mode mobile",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "test:issues": "node --test tests/issues.test.mjs",
    "test:models": "node --test tests/models.test.mjs",
    "preview": "vite preview --mode web",
    "start": "node scripts/serve.mjs",
    "dev:web": "vite --mode web",
    "dev:mobile": "vite --mode mobile",
    "dev:mobile:https": "vite --mode mobile-https",
    "dev:api": "node server/api.mjs",
    "build:web": "vite build --mode web",
    "build:mobile": "vite build --mode mobile",
    "preview:web": "vite preview --mode web",
    "preview:mobile": "vite preview --mode mobile"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "lucide-react": "^1.60.0",
    "maplibre-gl": "^6.15.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.170.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "prettier": "^3.0.0"
  }
}
