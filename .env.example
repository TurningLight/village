# Server only. Never prefix an API Key with VITE_. Use Beijing-region Model Studio credentials.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TEXT_MODEL=qwen-plus
# For the standalone production server: npm run start
HOST=0.0.0.0
API_PORT=5190
WEB_PORT=5181
MOBILE_PORT=5184
# Optional LAN HTTPS for phone recording: npm run dev:mobile:https
# Generate trusted development certificates first; these are paths, not certificate contents.
# MOBILE_HTTPS_CERT_FILE=.certs/mobile-cert.pem
# MOBILE_HTTPS_KEY_FILE=.certs/mobile-key.pem
# MOBILE_HTTPS_PORT=5175

# Work records, monthly reports and governance assistant (all share one text model).
# Empty GOV key uses the existing DASHSCOPE_API_KEY; never expose keys in VITE_*.
# GOVERNANCE_API_KEY=
GOVERNANCE_MODEL=qwen-plus
# Empty base uses DASHSCOPE_BASE_URL, then the Beijing compatible endpoint.
# GOVERNANCE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
