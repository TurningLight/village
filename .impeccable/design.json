  "narrative": {
    "northStar": "乡居共治",
    "overview": "沿用现有森林绿界面与浅绿白表面。桌面主要色彩来自 `src/index.css` 的 `--ui-*` 变量；手机使用独立的 `src/mobile/base.css` 与 `mobile.css`，延续既有品牌，不替换桌面视觉系统。正文使用系统中文无衬线字体，图标统一 Lucide。\n\n桌面工作区是 Operate 模式：紧凑顶部品牌与统计条，场景工具栏，主要空间视窗，右侧可收起业务面板。大部分首屏面积留给3D。手机为村民日常任务提供单列列表、明确主动作与受保护焦点的表单。",
    "keyCharacteristics": [
      "森林绿主动作与浅绿白表面。",
      "中文可读性优先，状态同时使用颜色、文字和图标。",
      "桌面空间工作区与手机单列任务界面分别适配。"
    ],
    "rules": [
      {
        "name": "状态有文字",
        "body": "状态颜色始终配合可读标签，不能只靠色相传达进展。",
        "section": "colors"
      },
      {
        "name": "输入可读",
        "body": "手机输入保持（16px），不为容纳更多字段缩小输入文字。",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** 沿用森林绿、浅绿白和 Lucide 图标，保留桌面既有视觉系统。",
      "**Do** 为状态、忙碌、错误、焦点与禁用提供明确的文字或交互反馈。",
      "**Do** 保持手机输入文字（16px），导航辅助标签至少（12px）。",
      "**Do** 为手机顶部、导航和提交栏保留安全区，并尊重减少动画偏好。"
    ],
    "donts": [
      "**Don't** 只用颜色表达问题状态。",
      "**Don't** 将手机示意地图呈现为真实GPS或测绘定位。",
      "**Don't** 用手机新规则覆盖桌面工作区及夜间场景的既有样式。"
    ]
  }
}
